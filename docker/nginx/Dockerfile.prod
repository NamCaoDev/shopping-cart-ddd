# Production web tier. PHP sources live in the php-fpm image; nginx needs the
# document root present so it can resolve $realpath_root for FastCGI and serve
# anything static out of public/.
FROM nginx:1.27-alpine

COPY docker/nginx/default.prod.conf /etc/nginx/conf.d/default.conf
COPY public/ /var/www/html/public/

EXPOSE 80
